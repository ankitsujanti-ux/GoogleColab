# Copy to .env and fill in your values.
# When running as .exe, place .env in the same folder as the executable.

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
PUSHOVER_USER_KEY=
PUSHOVER_API_TOKEN=
EXCEL_PATH=./Data/patients.xlsx

SENDGRID_API_KEY=
SENDER_EMAIL=
RECEIVER_EMAIL=

CHECK_INTERVAL=5
AUTO_REFRESH_SECONDS=30
THRESHOLD_LOW=50
THRESHOLD_MED=80
TOAST_TIMEOUT=3

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_WHATSAPP_FROM=

PORT=5000
FLASK_DEBUG=false
# Optional: LOG_LEVEL=DEBUG|INFO|WARNING|ERROR (default INFO)
LOG_LEVEL=INFO

# Pharmacy lookup: 1 = use OpenStreetMap when city not in static list (default); 0 = static list only
# PHARMACY_USE_OSM=1
